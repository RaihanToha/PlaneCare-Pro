# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# FIREBASE_API_KEY: Firebase Web API key for authentication and sync.
# Configure this via the Secrets panel in AI Studio or within the app.
FIREBASE_API_KEY=DEFAULT_FIREBASE_API_KEY

# FIREBASE_PROJECT_ID: Default Firebase Project ID
FIREBASE_PROJECT_ID=plantcare-pro-2701c

